if result:
    print("Found:", result.group())
else:
    print("Not found")


#Range inside brackets:
#You can specify a range of characters, e.g., [0-9] to match any digit, or [a-z] to match any lowercase letter.


import re
pattern = r"[0-9]"
text = "5"
result = re.match(pattern, text)
if result:
    print("Found:", result.group())
else:
    print("Not found")


#Pipe (|)
#Meaning: Acts as a logical OR operator, matching either the expression before or after the pipe.

import re
pattern = r"a|b"
text = "a"
result = re.match(pattern, text)
if result:
    print("Found:", result.group())
else:
    print("Not found")


#Parentheses (())
#Meaning: Groups patterns together, allowing you to apply quantifiers (like *, +, {n,m}) to the entire group.

import re
pattern = r"(ab)+"
text = "abab"
result = re.match(pattern, text)
if result:
    print("Found:", result.group())
else:
    print("Not found")


#Backslash (\)
#Meaning: Escapes a special character or gives special meaning to a character.

#Escape special characters: You can use \ to escape characters like . or * to treat them literally.
#Special sequences:
#\d: Matches any digit (0-9).
#\D: Matches any non-digit.
#\w: Matches any alphanumeric character (a-z, A-Z, 0-9, and underscore _).
#\W: Matches any non-word character.
#\s: Matches any whitespace character (spaces, tabs, line breaks).
#\S: Matches any non-whitespace character.
#\b: Matches a word boundary.
#\B: Matches a non-word boundary.

import re
pattern = r"\d{3}-\d{2}-\d{4}"
text = "123-45-6789"
result = re.match(pattern, text)
if result:
    print("Found:", result.group())
else:
    print("Not found")


#Double Backslashes (\\)
#Meaning: In Python strings, you need to escape a backslash by using a double backslash (\\)
#because the single backslash is used for escaping.

import re
pattern = r"\\d"  # Matches the literal string "\d"
text = "\d"
result = re.match(pattern, text)
if result:
    print("Found:", result.group())
else:
    print("Not found")
