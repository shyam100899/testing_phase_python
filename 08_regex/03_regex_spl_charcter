import re
pattern = r"a.b"   # Matches any single character except a newline (\n)
text = "acb"
result = re.match(pattern, text)
if result:
    print("Found:", result.group())
else:
    print("Not found")

import re
pattern = r"^Hello"  #Matches the start of the string.
text = "Hello world"
result = re.match(pattern, text)
if result:
    print("Found:", result.group())
else:
    print("Not found")


import re
pattern = r"world$"   # Matches the end of the string.
text = "Hello world"
result = re.search(pattern, text)
if result:
    print("Found:", result.group())
else:
    print("Not found")

import re
pattern = r"a*b"    #Matches 0 or more repetitions of the preceding character or group.
text = "b"
result = re.match(pattern, text)    #Matches: "b", "ab", "aaab", "aaaaab" (anything where "b" follows zero or more "a"s)
if result:
    print("Found:", result.group())
else:
    print("Not found")


import re
pattern = r"a+b"   #Matches 1 or more repetitions of the preceding character or group.
text = "aaab"
result = re.match(pattern, text)  #Matches: "ab", "aaab", "aaaaab" (anything where one or more "a"s are followed by "b")
if result:
    print("Found:", result.group())
else:
    print("Not found")

import re
pattern = r"a?b" #Matches 0 or 1 occurrence of the preceding character or group.
text = "abc"
result = re.match(pattern, text)
if result:
    print("Found:", result.group())
else:
    print("Not found")


#Meaning: Matches between n and m repetitions of the preceding character or group.

#{n}: Exactly n repetitions.
#{n,}: At least n repetitions.
#{,m}: Up to m repetitions.
#{n,m}: Between n and m repetitions.import re
pattern = r"a{2,4}"
text = "aaa"
result = re.match(pattern, text)
if result:
    print("Found:", result.group())
else:
    print("Not found")

 #Square Brackets ([])
